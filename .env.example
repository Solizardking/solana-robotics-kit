# ============================================
# Solana Robotics Kit - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
#
# Website: https://solanarobotics.org
# $KIT Token: DZbPqtV5jrCaT7NY4D7BDwje3r8kw3t7JB43AXZZBAGS
# ============================================

# ============================================
# SOLANA CONFIGURATION
# ============================================

# Solana RPC endpoint
# Options: devnet, mainnet-beta, or custom URL
SOLANA_RPC_URL=https://api.devnet.solana.com

# Path to your Solana wallet keypair
# Generate with: solana-keygen new --outfile ~/.config/solana/robot-wallet.json
SOLANA_WALLET_PATH=~/.config/solana/id.json

# Network: devnet, mainnet-beta
SOLANA_NETWORK=devnet

# ============================================
# ROBOT CONFIGURATION
# ============================================

# Unique robot identifier
ROBOT_ID=ROBOT-001

# Robot capabilities (comma-separated)
ROBOT_CAPABILITIES=navigation,delivery

# Polling interval for tasks (seconds)
TASK_POLL_INTERVAL=5

# ============================================
# $KIT TOKEN CONFIGURATION
# ============================================

# $KIT Token contract address (DO NOT CHANGE)
KIT_TOKEN_ADDRESS=DZbPqtV5jrCaT7NY4D7BDwje3r8kw3t7JB43AXZZBAGS

# Staking tier: basic, standard, premium, enterprise
STAKING_TIER=basic

# ============================================
# NVIDIA CONFIGURATION (Optional)
# ============================================

# NVIDIA API Key for NIM services
# Get yours at: https://build.nvidia.com
NVIDIA_API_KEY=

# Enable Jetson-specific optimizations
JETSON_MODE=false

# Enable CUDA acceleration
CUDA_ENABLED=false

# NIM endpoints (leave blank for defaults)
NIM_COSMOS_ENDPOINT=
NIM_NEMOTRON_ENDPOINT=

# ============================================
# AI PROVIDER CONFIGURATION (Optional)
# ============================================

# OpenAI API Key
OPENAI_API_KEY=

# OpenAI Model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=

# OpenRouter API Key (for Gemini, etc.)
OPENROUTER_API_KEY=

# ============================================
# ROBOT PASSPORT CONFIGURATION (Optional)
# ============================================

# FAL AI API Key for passport image generation
FAL_API_KEY=

# Default passport style: cyberpunk, industrial, minimal, holographic
PASSPORT_STYLE=cyberpunk

# ============================================
# TRADING AGENT CONFIGURATION (Optional)
# ============================================

# Enable trading agent
TRADING_ENABLED=false

# Birdeye API Key (for Solana token data)
BIRDEYE_API_KEY=

# Maximum trade size in SOL
MAX_TRADE_SIZE=0.1

# ============================================
# HARDWARE CONFIGURATION (Optional)
# ============================================

# Enable hardware sensors/actuators
HARDWARE_ENABLED=false

# ROS 2 distribution (humble, iron)
ROS_DISTRO=humble

# Camera device
CAMERA_DEVICE=/dev/video0

# Serial port for motor controller
MOTOR_SERIAL_PORT=/dev/ttyUSB0

# ============================================
# LOGGING & DEBUGGING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured JSON logging
JSON_LOGGING=false

# ============================================
# WEB CONSOLE CONFIGURATION
# ============================================

# Port for operator console (Next.js)
OPERATOR_CONSOLE_PORT=3000

# Port for robot daemon API
ROBOT_DAEMON_PORT=8000

# Port for trading agent WebSocket
TRADING_AGENT_PORT=8080

# ============================================
# DATABASE CONFIGURATION (Optional)
# ============================================

# Redis URL for caching
REDIS_URL=

# PostgreSQL URL for persistent storage
DATABASE_URL=
