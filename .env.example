# ============================================
# Solana Robotics — Environment (EXAMPLE ONLY)
# ============================================
# Copy to .env and fill values. Never commit .env or keypairs.
#
# $CLAWD mint: 8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
# ============================================

# --- Solana ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# Prefer Helius for DAS token gating
HELIUS_API_KEY=
HELIUS_RPC_URL=
# Optional override (defaults to official $CLAWD mint)
CLAWD_TOKEN_ADDRESS=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
TOKEN_ADDRESS=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
ADMIN_WALLET=

# Wallet path for server-side ops ONLY in local dev — never commit the file
SOLANA_WALLET_PATH=
# Do not put private keys in env for open-source clones; use wallet adapter in the browser

# --- Data / markets ---
BIRDEYE_API_KEY=
JUPITER_API_KEY=
DATABASE_URL=

# --- AI (optional) ---
XAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# --- Voice (optional) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
ELEVENLABS_API_KEY=

# --- App ---
NODE_ENV=development
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

# --- Brain harness (optional; can live in brain/.env) ---
# See brain/.env.example
