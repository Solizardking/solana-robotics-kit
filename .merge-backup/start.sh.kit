#!/bin/bash

# ============================================================================
# Solana Robotics Kit - One-Shot Developer Setup
# ============================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ASCII Art for Solana Robotics Kit
print_kit_art() {
    echo -e "${PURPLE}"
    cat << "EOF"
    ╔═══════════════════════════════════════════════════════════════════╗
    ║                                                                   ║
    ║     ███████╗ ██████╗ ██╗      █████╗ ███╗   ██╗ █████╗                ║
    ║     ██╔════╝██╔═══██╗██║     ██╔══██╗████╗  ██║██╔══██╗               ║
    ║     ███████╗██║   ██║██║     ███████║██╔██╗ ██║███████║               ║
    ║     ╚════██║██║   ██║██║     ██╔══██║██║╚██╗██║██╔══██║               ║
    ║     ███████║╚██████╔╝███████╗██║  ██║██║ ╚████║██║  ██║               ║
    ║     ╚══════╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝               ║
    ║                                                                       ║
    ║     ██████╗  ██████╗ ██████╗  ██████╗ ████████╗██╗ ██████╗ ███████╗   ║
    ║     ██╔══██╗██╔═══██╗██╔══██╗██╔═══██╗╚══██╔══╝██║██╔═══██╗██╔════╝   ║
    ║     ██████╔╝██║   ██║██████╔╝██║   ██║   ██║   ██║██║   ██║███████╗   ║
    ║     ██╔══██╗██║   ██║██╔══██╗██║   ██║   ██║   ██║██║   ██║╚════██║   ║
    ║     ██║  ██║╚██████╔╝██████╔╝╚██████╔╝   ██║   ██║╚██████╔╝███████║   ║
    ║     ╚═╝  ╚═╝ ╚═════╝ ╚═════╝  ╚═════╝    ╚═╝   ╚═╝ ╚═════╝ ╚══════╝   ║
    ║                                                                   ║
    ║              🤖 Solana Robotics Kit - Developer Setup 🤖        ║
    ║                                                                   ║
    ╚═══════════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}"
}

# Print header
clear
print_kit_art

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}🚀 Starting Solana Robotics Kit Developer Setup${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

# Get script directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR"

# Check Python version
echo -e "${BLUE}📋 Checking Python version...${NC}"
if ! command -v python3 &> /dev/null; then
    echo -e "${RED}❌ Python 3 is not installed. Please install Python 3.8+${NC}"
    exit 1
fi

PYTHON_VERSION=$(python3 --version | cut -d' ' -f2 | cut -d'.' -f1,2)
echo -e "${GREEN}✅ Python ${PYTHON_VERSION} found${NC}\n"

# Check Node.js version
echo -e "${BLUE}📋 Checking Node.js version...${NC}"
if ! command -v node &> /dev/null; then
    echo -e "${YELLOW}⚠️  Node.js not found. Skipping website setup...${NC}\n"
    SKIP_WEBSITE=true
else
    NODE_VERSION=$(node --version)
    echo -e "${GREEN}✅ Node.js ${NODE_VERSION} found${NC}\n"
    SKIP_WEBSITE=false
fi

# Check Solana CLI
echo -e "${BLUE}📋 Checking Solana CLI...${NC}"
if ! command -v solana &> /dev/null; then
    echo -e "${YELLOW}⚠️  Solana CLI not found. Install from: https://docs.solana.com/cli/install-solana-cli-tools${NC}\n"
else
    SOLANA_VERSION=$(solana --version | head -n1)
    echo -e "${GREEN}✅ ${SOLANA_VERSION}${NC}\n"
fi

# Setup Python environment
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}🐍 Setting up Python environment...${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

# Create virtual environment if it doesn't exist
if [ ! -d "venv" ]; then
    echo -e "${YELLOW}📦 Creating Python virtual environment...${NC}"
    python3 -m venv venv
    echo -e "${GREEN}✅ Virtual environment created${NC}\n"
else
    echo -e "${GREEN}✅ Virtual environment already exists${NC}\n"
fi

# Activate virtual environment
echo -e "${YELLOW}🔌 Activating virtual environment...${NC}"
source venv/bin/activate
echo -e "${GREEN}✅ Virtual environment activated${NC}\n"

# Install Python dependencies
if [ -f "requirements.txt" ]; then
    echo -e "${YELLOW}📦 Installing Python dependencies...${NC}"
    pip install --upgrade pip setuptools wheel
    pip install -r requirements.txt
    echo -e "${GREEN}✅ Python dependencies installed${NC}\n"
else
    echo -e "${YELLOW}⚠️  requirements.txt not found, skipping Python dependencies${NC}\n"
fi

# Setup website (if Node.js is available)
if [ "$SKIP_WEBSITE" = false ] && [ -d "website" ]; then
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}🌐 Setting up website...${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
    
    cd website
    
    # Install npm dependencies
    if [ -f "package.json" ]; then
        echo -e "${YELLOW}📦 Installing npm dependencies...${NC}"
        npm install
        echo -e "${GREEN}✅ npm dependencies installed${NC}\n"
    fi
    
    # Setup environment file
    if [ ! -f ".env" ] && [ -f "env.template" ]; then
        echo -e "${YELLOW}📝 Creating .env file from template...${NC}"
        cp env.template .env
        echo -e "${GREEN}✅ .env file created${NC}"
        echo -e "${YELLOW}⚠️  Please edit .env and add your API keys${NC}\n"
    fi
    
    cd ..
fi

# Setup Solana configuration
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}⛓️  Setting up Solana configuration...${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

if command -v solana &> /dev/null; then
    # Set to devnet by default
    echo -e "${YELLOW}🔧 Configuring Solana CLI for devnet...${NC}"
    solana config set --url https://api.devnet.solana.com
    echo -e "${GREEN}✅ Solana CLI configured for devnet${NC}\n"
    
    # Check if wallet exists
    if [ ! -f ~/.config/solana/id.json ]; then
        echo -e "${YELLOW}💼 Creating new Solana wallet...${NC}"
        solana-keygen new --outfile ~/.config/solana/id.json --no-bip39-passphrase
        echo -e "${GREEN}✅ Wallet created${NC}\n"
    else
        echo -e "${GREEN}✅ Solana wallet found${NC}\n"
    fi
    
    # Show wallet address
    WALLET_ADDRESS=$(solana address)
    echo -e "${CYAN}💰 Wallet Address: ${WALLET_ADDRESS}${NC}"
    echo -e "${YELLOW}💡 Get devnet SOL: https://faucet.solana.com/${NC}\n"
fi

# Create necessary directories
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}📁 Creating project directories...${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

DIRS=(
    "logs"
    "data"
    "configs/devnet"
    "website/public/passports"
)

for dir in "${DIRS[@]}"; do
    if [ ! -d "$dir" ]; then
        mkdir -p "$dir"
        echo -e "${GREEN}✅ Created directory: $dir${NC}"
    else
        echo -e "${GREEN}✅ Directory exists: $dir${NC}"
    fi
done
echo ""

# Summary
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✨ Setup Complete!${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

echo -e "${BLUE}📚 Next Steps:${NC}\n"

echo -e "${YELLOW}1. Activate Python environment:${NC}"
echo -e "   ${CYAN}source venv/bin/activate${NC}\n"

if [ "$SKIP_WEBSITE" = false ] && [ -d "website" ]; then
    echo -e "${YELLOW}2. Start the website:${NC}"
    echo -e "   ${CYAN}cd website && npm run dev${NC}\n"
fi

echo -e "${YELLOW}3. Set up Avatar Companion (optional):${NC}"
echo -e "   ${CYAN}cd avatar_companion && ./setup_avatar.sh${NC}\n"

echo -e "${YELLOW}4. Run examples:${NC}"
echo -e "   ${CYAN}python examples/quickstart.py${NC}\n"

if command -v solana &> /dev/null; then
    echo -e "${YELLOW}5. Get devnet SOL:${NC}"
    echo -e "   ${CYAN}solana airdrop 2${NC}\n"
fi

echo -e "${YELLOW}6. Read documentation:${NC}"
echo -e "   ${CYAN}cat README.md${NC}\n"

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${PURPLE}🤖 Happy Building! Welcome to Solana Robotics Kit! 🤖${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
