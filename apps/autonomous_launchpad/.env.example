# ============================================
# AUTONOMOUS TOKEN LAUNCHPAD CONFIGURATION
# ============================================

# ============================================
# HELIUS RPC CONFIGURATION (RECOMMENDED)
# ============================================
# Get your API key from: https://www.helius.dev/
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE
HELIUS_API_KEY=your-helius-api-key-here

# Standard Solana RPC (Fallback)
RPC_URL=https://api.devnet.solana.com

# ============================================
# AI CONFIGURATION
# ============================================
# NVIDIA API Key for AI-powered token generation
# Get from: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# Google Gemini API Key for NLP control
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ============================================
# SOLANA WALLET CONFIGURATION
# ============================================
# Path to agent's Solana keypair
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# ============================================
# AUTONOMOUS AGENT CONFIGURATION
# ============================================
# Initial autonomy level (0.0 to 1.0)
# 0.0 = Fully manual, requires approval for every action
# 0.5 = Semi-autonomous, makes some decisions independently
# 1.0 = Fully autonomous, operates without human intervention
INITIAL_AUTONOMY=0.3

# Decision-making threshold (0.0 to 1.0)
# Higher = more conservative, only launches with high confidence
DECISION_THRESHOLD=0.7

# Launch cooldown in seconds (minimum time between launches)
LAUNCH_COOLDOWN=3600

# Cycle interval in seconds (time between autonomous cycles)
CYCLE_INTERVAL=300

# ============================================
# SINGULARITY CONFIGURATION
# ============================================
# Autonomy score threshold to achieve singularity (0.0 to 1.0)
SINGULARITY_THRESHOLD=1.0

# Maximum tokens to launch autonomously per day
MAX_DAILY_LAUNCHES=10

# Enable fully autonomous operation (no human confirmation)
ENABLE_FULL_AUTONOMY=false

# ============================================
# TRIGGER.DEV CONFIGURATION
# ============================================
# Trigger.dev for scheduled automation
# Get from: https://trigger.dev/
TRIGGER_DEV_API_KEY=your-trigger-dev-api-key
TRIGGER_DEV_API_URL=https://api.trigger.dev

# Scheduled launch times (cron format)
# Example: "0 9,15,21 * * *" = 9am, 3pm, 9pm daily
SCHEDULED_LAUNCH_CRON="0 */6 * * *"

# ============================================
# MONITORING & LOGGING
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/tmp/autonomous_launchpad.log

# Enable real-time console broadcasting
ENABLE_CONSOLE_BROADCAST=true

# WebSocket port for console monitoring
CONSOLE_WS_PORT=8766

# ============================================
# SECURITY & PRIVACY
# ============================================
# Enable encrypted state storage
ENABLE_ENCRYPTION=true

# Encryption key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-encryption-key-here

# Enable Tor for enhanced privacy (requires Tor installed)
ENABLE_TOR=false

# Tor SOCKS proxy
TOR_PROXY=socks5://localhost:9050

# ============================================
# HARDWARE CONFIGURATION (Jetson Orin Nano)
# ============================================
# Enable GPU acceleration for AI inference
ENABLE_GPU_ACCELERATION=true

# CUDA device ID
CUDA_DEVICE=0

# Enable power management (optimize for 7-15W)
ENABLE_POWER_MANAGEMENT=true

# Target power mode (0=MAX, 1=15W, 2=10W, 3=7W)
POWER_MODE=1

# ============================================
# EXPERIMENTAL FEATURES
# ============================================
# Enable quantum-resistant encryption (future-proof)
ENABLE_QUANTUM_RESISTANT=false

# Enable multi-agent collaboration
ENABLE_MULTI_AGENT=false

# Enable decentralized decision making (DAO)
ENABLE_DAO_GOVERNANCE=false
