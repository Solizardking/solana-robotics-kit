# Solana Robotics Trading Agent Server Configuration

# ============================================
# SERVER CONFIGURATION
# ============================================
WS_HOST=localhost
WS_PORT=8765

# ============================================
# AI CONFIGURATION
# ============================================
# NVIDIA API Key for AI features (optional but recommended)
# Get from: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# Google Gemini API Key for voice command interpretation
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ============================================
# SOLANA CONFIGURATION
# ============================================
# Solana RPC URL
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana wallet keypair path (optional)
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# Deployed Program IDs
ROBOT_REGISTRY_PROGRAM_ID=Hr7zfhDMTcpKJErxL6ejSp5Bskj389KBfbwVZp3te8jj
TASK_ESCROW_PROGRAM_ID=8RHcLMMNvbCKsXBQn1pLa9n6L1dheMtz8n9B83REr94i
ACTION_LOG_PROGRAM_ID=8FkpUMkmcSgWHJ2TqB1xJ1t9y1bphSkJqvBxWs2eHqAr

# ============================================
# TRADING CONFIGURATION
# ============================================
# Auto-pilot settings
AUTO_PILOT_ENABLED=false
MAX_TRADE_AMOUNT=10.0  # Maximum SOL per trade

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/tmp/trading_agent.log
