# Solana-Automation Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ============================================
# Server Configuration
# ============================================
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Solana Configuration (REQUIRED)
# ============================================
# Private key in base58 format or JSON array format
# Example base58: 5KJvsngHeM...
# Example JSON array: [123,45,67,...]
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
NETWORK=devnet
SOLANA_WALLET_PATH=./key/wallet.json

# ============================================
# AI Provider APIs (At least one required)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPEN_ROUTER_API_KEY=
DEFAULT_MODEL=anthropic/claude-3-opus-20240229

# ============================================
# Third-party Service APIs (Optional)
# ============================================
HELIUS_API_KEY=
E2B_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_API_KEY=  # For Gemini AI (GR00T Avatar)
NGROK_AUTHTOKEN=  # For public URL (GR00T Avatar, optional)
BIRDEYE_API_KEY=
PHALA_API_KEY=

# ============================================
# Database Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017/solana_ai_agent
REDIS_URI=redis://localhost:6379/0

# ============================================
# Authentication Settings
# ============================================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION=86400

# ============================================
# Trading Configuration (Safety Settings)
# ============================================
TRADING_ENABLED=false
MAX_TRADE_AMOUNT=0.1
MAX_DAILY_TRADES=5
AUTO_APPROVE_THRESHOLD=0.01

# ============================================
# Browser Automation Settings
# ============================================
BROWSER_HEADLESS=False

# ============================================
# Agent Configuration
# ============================================
DEFAULT_AGENT_NAME=MyTradingAgent
INITIAL_TRADING_CAPITAL=1000

# ============================================
# MCP Server Configuration
# ============================================
MCP_PORT=3000
RPC_URL=https://api.devnet.solana.com

