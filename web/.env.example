# ============================================
# Solana Robotics — Environment (EXAMPLE ONLY)
# ============================================
# Copy to .env and fill values. Never commit .env or keypairs.
#
# $CLAWD mint: 8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
# ============================================

# --- Solana ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# Prefer Helius for DAS token gating
HELIUS_API_KEY=
HELIUS_RPC_URL=
# Optional override (defaults to official $CLAWD mint)
CLAWD_TOKEN_ADDRESS=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
TOKEN_ADDRESS=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
ADMIN_WALLET=

# Wallet path for server-side ops ONLY in local dev — never commit the file
SOLANA_WALLET_PATH=
# Do not put private keys in env for open-source clones; use wallet adapter in the browser

# --- Data / markets ---
BIRDEYE_API_KEY=
JUPITER_API_KEY=
DATABASE_URL=

# --- AI (optional) ---
XAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# --- Moonshot / Kimi K3 (SOL GPT trading + vision) ---
# Product default LLM when set. Aliases accepted: KIMI_API_KEY, MOONSHOT_AI_API_KEY
# Full 171-tool catalog: docs/SOL_GPT.md · Product: cheshireterminal.ai/sol-gpt
MOONSHOT_API_KEY=
KIMI_API_KEY=
MOONSHOT_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
SOL_GPT_PROVIDER=auto
# OPENROUTER_DEFAULT_MODEL=poolside/laguna-s-2.1:free
# OPENROUTER_LAGUNA_MODEL=poolside/laguna-s-2.1
# OPENROUTER_OPUS_MODEL=anthropic/claude-opus-5-fast
# DEEPSEEK_API_KEY=
# POOLSIDE_API_KEY=

# --- Nemotron 3 Nano Omni (local/vLLM testing; do not load BF16 without H100-class GPU) ---
# docs/NEMOTRON_OMNI.md
NEMOTRON_PRECISION=nvfp4
# NEMOTRON_MODEL_ID=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
NEMOTRON_ALLOW_LOAD=0
# NEMOTRON_BASE_URL=http://127.0.0.1:8000/v1
# HF_TOKEN=

# --- Asimov / Menlo (direct robot control) ---
# sk_live_… from https://platform.menlo.ai or https://console.menlo.ai
# Kit alias (preferred). Upstream SDK also accepts MENLO_API_KEY.
# Docs (working): https://docs.menlo.ai/platform/reference/python-sdk
#                 https://docs.menlo.ai/asimov/1/api
ASIMOV_API_KEY=
MENLO_API_KEY=
MENLO_RCS_URL=https://api.menlo.ai/rcs
ASIMOV_ROBOT_NAME=Solana-Asimov
ASIMOV_ROBOT_MODEL=asimov-v0
ASIMOV_ROBOT_ID=
ASIMOV_RUNTIME=simplesim
ASIMOV_VIEWER_URL=https://sim.menlo.ai
ASIMOV_MAX_LINEAR_MPS=0.5
ASIMOV_MAX_YAW_RPS=0.8
# Multi-node fabric: Orin Nano (motors) + Raspberry Pi (sensors) + Topion
HARDWARE_ENABLED=false
ORIN_HOST=orin-nano.local
ORIN_PORT=9101
RPI_HOST=raspberrypi.local
RPI_PORT=9102
TOPION_HOST=topion.local
TOPION_PORT=9103
TOPION_ROLE=expansion

# --- Voice (optional) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
ELEVENLABS_API_KEY=

# --- App ---
NODE_ENV=development
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

# --- Brain harness (optional; can live in brain/.env) ---
# See brain/.env.example

# NVIDIA NIM (SOLtron brain) + Convex
NVIDIA_API_KEY=
CONVEX_CLOUD=https://posh-hyena-993.convex.cloud
CONVEX_URL=https://posh-hyena-993.convex.site
VITE_CONVEX_URL=https://posh-hyena-993.convex.site

# CLAWD brain (SOLtron companion): server-only
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
[SECURITY_DATA]
# NOTE: default in code is the EOL nemotron-3-nano-30b-a3b (HTTP 410) — set the Omni successor:
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
XAI_MODEL=grok-4-fast-reasoning
